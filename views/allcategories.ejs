<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categories | BacklogBeater</title>
    <link rel="stylesheet" href="/style/styles.css">
</head>
<body>
    <header class="site-header"><h1>Categories</h1><nav><a href="/">Home</a><a href="/games">Games</a></nav></header>
    <main class="page">
        <div class="page-header"><h2>All categories</h2><a class="button" href="./categories/new">Add a category</a></div>
        <% if (categoriesArray.length == 0) { %>
            <p class="card empty">No categories yet. Add one to get started.</p>
        <% } else { %>
            <div class="item-list">
                <% categoriesArray.forEach(category => { %>
                    <a class="item-link" href="./categories/<%=category.category_id %>"><%= category.name %></a>
                <% }) %>
            </div>
        <% } %>
    </main>
</body>
</html>
