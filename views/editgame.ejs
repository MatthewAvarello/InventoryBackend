<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>e</h1>
    <div id="inputs">
        <label for="name">name</label>
        <input type="text" name="name" id="name">
        <label for="category_id">category_id</label>
        <input type="number" name="category_id" id="category_id">
        <label for="hours_played">hours_played</label>
        <input type="number" name="hours_played" id="hours_played">
        <label for="image_link">image_link</label>
        <input type="text" name="image_link" id="image_link">
        <label for="played">played</label>
        <input type="text" name="played" id="played">
        <label for="user_rating">user_rating</label>
        <input type="number" name="user_rating" id="user_rating">
        <label for="description">description</label>
        <input type="text" name="description" id="description">
    </div>
    <button id="patchButton">update</button>
    <script>
        
        const button = document.getElementById("patchButton")
        button.addEventListener("click", async () => {
            let inputs = document.querySelectorAll('input')
            let values = {}
            for (let i = 0; i < inputs.length; i++) {
                let input = inputs[i]
                let id = input.id
                let value = input.value
                if (value == ""){
                    continue
                }
                values[id] = value
            }
            console.log(values)
            values = JSON.stringify(values)
            let response = await fetch(window.location.href,{
                method: "PATCH",
                headers: {
                    'Content-Type': 'application/json'
                },
                body: values
            })
            if(response.ok){
                console.log("ok")
            }
        })
       
    </script>
</body>
</html>