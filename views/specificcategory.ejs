<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= categorydata[0].name %> | BacklogBeater</title>
    <link rel="stylesheet" href="/style/styles.css">
</head>
<body>
    <header class="site-header"><h1>Category details</h1><nav><a href="/">Home</a><a href="/categories">Categories</a></nav></header>
    <main class="page"><section class="card">
        <h2><%= categorydata[0].name %></h2>
        <p><%= categorydata[0].description %></p>
        <h3>Games</h3>
        <% if (gamedata.length == 0) { %><p class="empty">No games in this category yet.</p><% } else { %>
            <div class="item-list"><% gamedata.forEach(game => { %><a class="item-link" href="/games/<%=game.game_id %>"><%= game.name %></a><% }) %></div>
        <% } %>
        <div class="actions"><a href="/categories">Go back</a><button class="danger" id="deleteButton">Delete category</button></div>
    </section></main>
    <script>
        document.getElementById("deleteButton").addEventListener("click", async () => {
            if (!confirm("Delete this category?")) return;
            const response = await fetch(window.location.href, { method: "DELETE" });
            if (response.ok) window.location.href = "/categories";
        });
    </script>
</body>
</html>
