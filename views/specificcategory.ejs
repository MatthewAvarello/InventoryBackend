<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1><%= categorydata[0].name %></h1>
    <h2><%= categorydata[0].description %></h2>
    <a href="/categories">Go back</a>
    <h2>games:</h2>
    <% if (gamedata.length == 0) { %>
        <h3>No games in thsi category, add some?</h3>
    <% } else { %>
    <% gamedata.forEach(game => { %>
        <a href="/games/<%=game.game_id %>"><%= game.name %></a>
    <% })} %>
    <button id="deleteButton">Delete</button>
    <script>
        let button = document.getElementById("deleteButton").addEventListener("click", async () => {
            let url = window.location.href
            let response = await fetch(url,{
                method: "DELETE"
            })
            if (response.ok){
                console.log("ok")
                window.location.href = "/categories"
            }
        })
    </script>
</body>
</html>