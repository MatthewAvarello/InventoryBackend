<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1><%= gamedata[0].name %></h1>
    <p><%= gamedata[0].description %></p>
    <p><%= gamedata[0].hours_played%></p>
    <p><%= gamedata[0].played%></p>
    <p><%= gamedata[0].user_rating%></p>
    <img src="<%= gamedata[0].image_link %>" alt="">
    <button id="deleteButton">Delete</button>
    <script>
        let button = document.getElementById("deleteButton").addEventListener("click", async () => {
            let url = window.location.href
            let response = await fetch(url,{
                method: "DELETE"
            })
            if (response.ok){
                console.log("ok")
                window.location.href = "/games"
            }
        })
    </script>
</body>
</html>